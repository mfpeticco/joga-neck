  <!-- pan (yaw), + = look left -->
  <joint name="revolute_1" type="revolute">
    <parent link="root" />
    <child link="pan_link" />
    <origin xyz="0 -0.0367000796 0.0505000597" rpy="3.14159 2.65359683e-06 2.65357134e-06" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.5708" upper="1.5708" effort="0.93" velocity="8.48" />
  </joint>
  <!-- tilt (pitch), + = look down -->
  <joint name="revolute_2" type="revolute">
    <parent link="pan_link" />
    <child link="tilt_link" />
    <origin xyz="0.0141570174 0.0305001547 -0.0286398793" rpy="-1.57079265 0 -1.57078735" />
    <axis xyz="0 0 1" />
    <limit lower="-0.3491" upper="1.5708" effort="0.93" velocity="8.48" />
  </joint>
  <!-- Camera optical frame on the OAK-1 W (same pose as the original camera_frame). -->
  <link name="camera_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-09" />
      <inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12" />
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="tilt_link" />
    <child link="camera_frame" />
    <origin xyz="-0.00883897264 0.0487498674 -0.0144588247" rpy="1.5708 -2.65360329e-06 -3.14158796" />
  </joint>
