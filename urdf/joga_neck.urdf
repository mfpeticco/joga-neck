<?xml version="1.0" encoding="utf-8"?>
<!-- Joga Neck: 2-DoF pan-tilt camera neck for the Unitree G1 (https://joga.csail.mit.edu/neck/).
     The kinematics, camera frame, and mass properties are the model used to train the Joga policies,
     with one link per rigid body. Units: m, kg, rad.
     revolute_1 = pan (+ = look left), revolute_2 = tilt (+ = look down).
     Attach `root` to the G1 torso; g1/g1_joga_neck.xml does this at the calibrated mount pose. -->
<robot name="joga_neck">
  <mujoco>
    <compiler meshdir="meshes/" strippath="true" discardvisual="false" fusestatic="false" />
  </mujoco>
  <!-- Torso Mount and the pan (yaw) servo body. Attach this link to the G1 torso. -->
  <link name="root">
    <inertial>
      <origin xyz="-1.88947806e-06 -0.0165475179 0.0317838142" rpy="0 0 0" />
      <mass value="0.0569618527" />
